# Local Web API gateway
DANXI_BIND_ADDR=127.0.0.1:8787
DANXI_ALLOWED_ORIGIN=http://127.0.0.1:1420

# Optional upstream HTTP(S) proxy used by the Rust backend only.
# DANXI_HTTP_PROXY=http://127.0.0.1:7897

# Optional upstream overrides.
# DANXI_FORUM_BASE_URL=https://forum.fduhole.com/api
# DANXI_AUTH_BASE_URL=https://auth.fduhole.com/api
# DANXI_DANKE_BASE_URL=https://danke.fduhole.com/api

# Production Web frontend API origin. Development uses Vite's /api proxy.
# VITE_DANXI_API_BASE_URL=https://api.example.com
