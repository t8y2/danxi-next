{
  "name": "danxi-next",
  "version": "0.1.2",
  "description": "A maintainable web and desktop client for DanXi, built with Tauri and Svelte.",
  "repository": {
    "type": "git",
    "url": "https://github.com/t8y2/danxi-next.git"
  },
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:web": "DANXI_RUNTIME=web vite dev",
    "dev:web-server": "cargo run -p danxi-server",
    "build": "vite build",
    "build:web": "DANXI_RUNTIME=web vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:rust": "cargo check --workspace",
    "check:all": "pnpm check && pnpm check:rust",
    "test:forum": "node --experimental-strip-types --test --test-concurrency=1 scripts/forum-*.test.mjs",
    "release:check": "node scripts/check-release-version.mjs",
    "tauri": "tauri"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@lucide/svelte": "^1.48.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "entities": "^8.1.0",
    "marked": "^18.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.137",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@unocss/reset": "^66.10.5",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "unocss": "^66.10.5",
    "vite": "^8.0.16"
  }
}
